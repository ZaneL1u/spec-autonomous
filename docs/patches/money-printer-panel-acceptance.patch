+def completed_wave_files(parent, current):
+    """Hash only finished output owned by this harness, never coordinator logs."""
+    inherited = {}
+    for previous in parent.iterdir():
+        if previous == current or not previous.is_dir() or previous.is_symlink():
+            continue
+        manifest = previous / 'manifest.json'
+        if not manifest.is_file() or manifest.is_symlink():
+            continue
+        try:
+            record = json.loads(manifest.read_text())
+        except (OSError, ValueError):
+            continue
+        if not (record.get('schema_version') == 1
+                and record.get('wave') == previous.name
+                and record.get('status') in {'PASS', 'FAIL'}
+                and record.get('end') and record.get('cleanup')
+                and isinstance(record.get('suites'), list)):
+            continue
+        for artifact in previous.rglob('*'):
+            if artifact.is_symlink():
+                raise AssertionError(f'prior wave symlink: {artifact}')
+            if artifact.is_file():
+                inherited[str(artifact.relative_to(parent))] = digest(artifact)
+    return inherited
+
