{
  "name": "spec-autonomous",
  "private": true,
  "description": "Git-installable facade for the Spec Autonomous CLI",
  "type": "module",
  "bin": {
    "spec-autonomous": "packages/cli/bin/spec-autonomous.mjs"
  },
  "files": [
    "packages/cli/bin",
    "packages/cli/lib",
    "packages/cli/skills",
    "packages/cli/locales",
    "packages/cli/package.json",
    "git-install.json",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/ZaneL1u/spec-autonomous.git"
  },
  "version": "0.1.0-alpha.13",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": "^22.13.0 || >=23.5.0"
  },
  "scripts": {
    "build:cli": "tsdown",
    "build:native": "node scripts/build-native.mts",
    "typecheck": "tsc --noEmit",
    "test": "cargo test --workspace --locked && node --test packages/cli/test/*.test.mts scripts/test/*.test.mts",
    "check": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets --locked -- -D warnings",
    "spec:validate": "openspec validate --all --strict --no-interactive",
    "pack:local": "node scripts/pack-local.mts",
    "package:release": "node scripts/package-release.mts",
    "references:clone": "node scripts/clone-references.mts",
    "test:unit": "cargo test --workspace --locked",
    "test:package": "node --test packages/cli/test/*.test.mts scripts/test/*.test.mts",
    "test:provider": "cargo test -p spec-autonomous-core --locked --test provider_contracts real_openspec_plans_then_accepts_skipped_specs_and_custom_tracking_artifact -- --ignored --exact",
    "test:e2e": "cargo build -p spec-autonomous-cli --locked && node --test --test-concurrency=2 tests/e2e/*.test.mts",
    "test:all": "node scripts/test-all.mts",
    "docs:dev": "vitepress dev website",
    "docs:build": "vitepress build website",
    "docs:preview": "vitepress preview website",
    "mock:create": "node scripts/create-mock-repo.mts",
    "mock:run": "node tests/mock-host.mts",
    "dogfood": "node scripts/dogfood.mts"
  },
  "dependencies": {
    "commander": "14.0.3",
    "@inquirer/prompts": "8.7.2"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.13.0",
    "@types/node": "^26.6.2",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitepress": "1.6.4"
  }
}
