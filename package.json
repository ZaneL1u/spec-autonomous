{
  "name": "spec-autonomous-workspace",
  "private": true,
  "version": "0.1.0-alpha.4",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build-native.mjs",
    "test": "cargo test --workspace --locked && node --test packages/cli/test/*.test.mjs scripts/test/*.test.mjs",
    "check": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets --locked -- -D warnings",
    "spec:validate": "openspec validate --all --strict --no-interactive",
    "pack:local": "node scripts/pack-local.mjs",
    "package:release": "node scripts/package-release.mjs",
    "references:clone": "node scripts/clone-references.mjs",
    "test:unit": "cargo test --workspace --locked",
    "test:package": "node --test packages/cli/test/*.test.mjs scripts/test/*.test.mjs",
    "test:provider": "cargo test -p spec-autonomous-core --locked --test provider_contracts real_openspec_plans_then_accepts_skipped_specs_and_custom_tracking_artifact -- --ignored --exact",
    "test:e2e": "cargo build -p spec-autonomous-cli --locked && node --test --test-concurrency=2 tests/e2e/*.test.mjs",
    "test:all": "node scripts/test-all.mjs",
    "mock:create": "node scripts/create-mock-repo.mjs",
    "mock:run": "node tests/mock-host.mjs"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.13.0"
  }
}
